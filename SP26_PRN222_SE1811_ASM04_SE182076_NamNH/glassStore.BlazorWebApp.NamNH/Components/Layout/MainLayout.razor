@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex align-items-center justify-content-between">
            <span class="text-muted small fw-medium">Assignment 4 - Management System</span>
            <div class="d-flex align-items-center gap-3">
                <a href="https://learn.microsoft.com/aspnet/core/" target="_blank" class="text-muted small text-decoration-none">
                    <i class="fas fa-book-open me-1"></i> Docs
                </a>
            </div>
        </div>

        <article class="content px-4 py-4">
            <div class="container-fluid">
                @Body
            </div>
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
