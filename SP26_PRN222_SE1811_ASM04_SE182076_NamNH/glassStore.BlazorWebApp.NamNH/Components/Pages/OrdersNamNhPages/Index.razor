@code {
    // private glass_StoreContext context = default!;
    private IQueryable<OrdersNamNh> ordersNamNhs = default;

 

    protected override async Task OnInitializedAsync()
    {
        // context = DbFactory.CreateDbContext();
        try
        {
            ordersNamNhs = (await _ordersNamNhService.GetAllAsync()).AsQueryable();
        }catch(Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    public ValueTask DisposeAsync()
    {
        return ValueTask.CompletedTask;
    }
}
