@page
@model glassStore.RazorWebApp.NamNH.Pages.OrdersNamNhs.DeleteModel

@{
    ViewData["Title"] = "Delete Order";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0">

                <!-- HEADER -->
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">⚠️ Delete Order</h4>
                </div>

                <!-- BODY -->
                <div class="card-body">
                    <div class="alert alert-warning">
                        <strong>Warning!</strong>
                        This action <u>cannot be undone</u>.
                        Please review the order details carefully before deleting.
                    </div>

                    <h6 class="text-muted mb-3">Order Summary</h6>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <p><strong>Order Code:</strong> @Model.OrdersNamNh.OrderCode</p>
                            <p><strong>Order Type:</strong> @Model.OrdersNamNh.OrderType</p>
                            <p>
                                <strong>Status:</strong>
                                <span class="badge
                                    @(Model.OrdersNamNh.Status == "Paid" ? "bg-success" :
                                                                            Model.OrdersNamNh.Status == "Pending" ? "bg-warning text-dark" :
                                                                            "bg-secondary")">
                                    @Model.OrdersNamNh.Status
                                </span>
                            </p>
                        </div>

                        <div class="col-md-6">
                            <p><strong>User:</strong> @Model.OrdersNamNh.User?.Email</p>
                            <p><strong>Payment:</strong> @Model.OrdersNamNh.PaymentMethod</p>
                            <p>
                                <strong>Voucher:</strong>
                                @(Model.OrdersNamNh.Voucher != null
                                                                ? Model.OrdersNamNh.Voucher.Code
                                                                : "No voucher")
                            </p>
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <p>Subtotal:</p>
                            <p>Discount:</p>
                            <p>Tax:</p>
                            <p>Shipping:</p>
                        </div>
                        <div class="col-md-6 text-end">
                            <p>₫ @Model.OrdersNamNh.Subtotal</p>
                            <p class="text-danger">- ₫ @Model.OrdersNamNh.DiscountTotal</p>
                            <p>₫ @Model.OrdersNamNh.TaxTotal</p>
                            <p>₫ @Model.OrdersNamNh.ShippingFee</p>
                        </div>
                    </div>

                    <div class="row border-top pt-3">
                        <div class="col-md-6">
                            <strong>Grand Total</strong>
                        </div>
                        <div class="col-md-6 text-end">
                            <strong class="text-danger fs-5">
                                ₫ @Model.OrdersNamNh.GrandTotal
                            </strong>
                        </div>
                    </div>

                    <hr />

                    <p class="text-muted small">
                        Created: @Model.OrdersNamNh.CreatedAt <br />
                        Updated: @Model.OrdersNamNh.UpdatedAt
                    </p>
                </div>

                <!-- FOOTER -->
                <div class="card-footer bg-light text-end">
                    <form method="post" class="d-inline">
                        <input type="hidden" asp-for="OrdersNamNh.OrderId" />
                        <a asp-page="./Index" class="btn btn-outline-secondary me-2">
                            ← Cancel
                        </a>
                        <button type="submit" class="btn btn-danger px-4">
                            🗑️ Delete Order
                        </button>
                        <input type="button"
                               id="btnHubDelete"
                               value="Delete By SignalR"
                               class="btn btn-warning ms-2" />
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>
<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
<script>
    "use strict";
    var connection = new signalR.HubConnectionBuilder().withUrl("/glassStore_Hub").build();

    connection.on("DeleteSuccess", function () {
        alert("Hệ thống: Đã xóa đơn hàng thành công!");
        window.location.href = "/OrdersNamNhs/Index";
    });
    connection.on("ReceiveErrorNamNH", function (msg) {
        alert("Lỗi: " + msg);
    });
    connection.start().then(function(){
        console.log("NamNH Delete: SignalR Connected");
    }).catch(err => console.error(err.toString()));
    document.getElementById("btnHubDelete").addEventListener("click", function (event) {
        var orderId = @Model.OrdersNamNh.OrderId;
        connection.invoke("hubDelete_OrdersNamNH", orderId)
            .catch(err => console.error(err.toString()));
        event.preventDefault();
    });
</script>
