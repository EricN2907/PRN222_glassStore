@page
@model glassStore.RazorWebApp.NamNH.Pages.OrdersNamNhs.EditModel

@{
    ViewData["Title"] = "Cập nhật đơn hàng";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-white shadow-sm rounded">
        <div>
            <h1 class="h3 mb-0 text-primary fw-bold">
                <i class="fas fa-edit me-2"></i>Chỉnh sửa Đơn hàng
            </h1>
            <p class="text-muted small mb-0">Cập nhật thông tin cho đơn hàng <strong class="text-primary">#@Model.OrdersNamNh.OrderCode</strong></p>
        </div>
        <a asp-page="./Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fa fa-arrow-left me-2"></i> Quay lại danh sách
        </a>
    </div>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-4" role="alert"></div>
        <input type="hidden" asp-for="OrdersNamNh.OrderId" />

        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 mb-4 rounded-3">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="m-0 fw-bold text-primary"><i class="fas fa-info-circle me-2"></i>Thông tin chung</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="OrdersNamNh.OrderCode" class="form-label text-muted small fw-bold">Mã đơn hàng</label>
                                <input asp-for="OrdersNamNh.OrderCode" class="form-control bg-light border-0 fw-bold" readonly />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="OrdersNamNh.Status" class="form-label small fw-bold text-dark">Trạng thái đơn hàng</label>
                                <select asp-for="OrdersNamNh.Status" class="form-select border-primary shadow-sm">
                                    <option value="Pending">Chờ xử lý</option>
                                    <option value="Processing">Đang xử lý</option>
                                    <option value="Completed">Đã hoàn thành</option>
                                    <option value="Cancelled">Đã hủy</option>
                                </select>
                                <span asp-validation-for="OrdersNamNh.Status" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="OrdersNamNh.UserId" class="form-label small fw-bold text-dark">Khách hàng (Tài khoản)</label>
                                <select asp-for="OrdersNamNh.UserId" class="form-select" asp-items="ViewBag.UserId">
                                    <option value="">-- Chọn khách hàng --</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="OrdersNamNh.VoucherId" class="form-label small fw-bold text-dark">Mã giảm giá áp dụng</label>
                                <select asp-for="OrdersNamNh.VoucherId" class="form-select" asp-items="ViewBag.VoucherId">
                                    <option value="">-- Không sử dụng --</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="OrdersNamNh.OrderType" class="form-label small fw-bold text-dark">Loại đơn hàng</label>
                                <input asp-for="OrdersNamNh.OrderType" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="OrdersNamNh.PaymentMethod" class="form-label small fw-bold text-dark">Phương thức thanh toán</label>
                                <select asp-for="OrdersNamNh.PaymentMethod" class="form-select">
                                    <option value="Tiền mặt">Tiền mặt</option>
                                    <option value="Banking">Chuyển khoản</option>
                                    <option value="VNPay">VNPay</option>
                                    <option value="COD">Giao hàng thu tiền (COD)</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label asp-for="OrdersNamNh.CustomerNote" class="form-label small fw-bold text-dark">Ghi chú từ khách hàng</label>
                                <textarea asp-for="OrdersNamNh.CustomerNote" class="form-control" rows="2" placeholder="Nhập ghi chú nếu có..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-0 mb-4 rounded-3">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="m-0 fw-bold text-info"><i class="fas fa-shipping-fast me-2"></i>Thông tin vận chuyển</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="OrdersNamNh.ReceiverName" class="form-label small fw-bold text-dark">Tên người nhận</label>
                                <input asp-for="OrdersNamNh.ReceiverName" class="form-control" />
                                <span asp-validation-for="OrdersNamNh.ReceiverName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="OrdersNamNh.ReceiverPhone" class="form-label small fw-bold text-dark">Số điện thoại liên lạc</label>
                                <input asp-for="OrdersNamNh.ReceiverPhone" class="form-control" />
                                <span asp-validation-for="OrdersNamNh.ReceiverPhone" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="OrdersNamNh.ReceiverAddress" class="form-label small fw-bold text-dark">Địa chỉ giao hàng chi tiết</label>
                                <input asp-for="OrdersNamNh.ReceiverAddress" class="form-control" />
                                <span asp-validation-for="OrdersNamNh.ReceiverAddress" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm mb-4 border-0 rounded-3 overflow-hidden">
                    <div class="card-header bg-primary text-white py-3">
                        <h6 class="m-0 fw-bold"><i class="fas fa-calculator me-2"></i>Tổng kết đơn hàng</h6>
                    </div>
                    <div class="card-body bg-light">
                        <div class="mb-3">
                            <label asp-for="OrdersNamNh.Subtotal" class="form-label small text-muted">Tạm tính</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0">₫</span>
                                <input asp-for="OrdersNamNh.Subtotal" class="form-control text-end border-start-0" placeholder="0" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="OrdersNamNh.DiscountTotal" class="form-label small text-muted">Giảm giá</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-success">-</span>
                                <input asp-for="OrdersNamNh.DiscountTotal" class="form-control text-end text-success border-start-0" placeholder="0" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="OrdersNamNh.TaxTotal" class="form-label small text-muted">Thuế</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0">+</span>
                                <input asp-for="OrdersNamNh.TaxTotal" class="form-control text-end border-start-0" placeholder="0" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="OrdersNamNh.ShippingFee" class="form-label small text-muted">Phí ship</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0">+</span>
                                <input asp-for="OrdersNamNh.ShippingFee" class="form-control text-end border-start-0" placeholder="0" />
                            </div>
                        </div>
                        <hr class="my-4" />
                        <div class="mb-3">
                            <label asp-for="OrdersNamNh.GrandTotal" class="form-label fw-bold h5">Tổng thanh toán</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-white border-primary text-primary fw-bold">₫</span>
                                <input asp-for="OrdersNamNh.GrandTotal" class="form-control text-end fw-bold text-primary border-primary" placeholder="0" />
                            </div>
                            <span asp-validation-for="OrdersNamNh.GrandTotal" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-0 mb-4 rounded-3">
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between mb-2 small text-muted">
                            <span>Ngày tạo:</span>
                            <span class="fw-bold">@Model.OrdersNamNh.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="d-flex justify-content-between small text-muted">
                            <span>Cập nhật mới nhất:</span>
                            <span class="fw-bold">@(Model.OrdersNamNh.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</span>
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg shadow-sm fw-bold rounded-pill">
                        <i class="fa fa-save me-2"></i> Lưu thay đổi
                    </button>
                    <a asp-page="./Index" class="btn btn-light text-secondary mt-2 rounded-pill">Hủy bỏ</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        "use strict";

        var connection = new signalR.HubConnectionBuilder().withUrl("/glassStore_Hub").build();

        connection.on("UpdateSuccess", function () {
            alert("Hệ thống: Đã cập nhật đơn hàng thành công qua SignalR!");
            window.location.href = "/OrdersNamNhs/Index";
        });

        connection.on("ReceiveErrorNamNH", function (msg) {
            alert("Lỗi: " + msg);
        });

        connection.start().then(function () {
            console.log("NamNH Edit: Connected to the SignalR Hub");
        }).catch(function (err) {
            return console.error(err.toString());
        });

        var currentOrderId = parseInt("@Model.OrdersNamNh.OrderId");

        connection.on("ReceiveDelete_OrdersNamNH", function (orderId) {
            if (currentOrderId === parseInt(orderId)) {
                var btnSb = document.querySelector('button[type="submit"]');
                if(btnSb) btnSb.disabled = true;
                
                var notification = document.createElement("div");
                notification.className = "alert alert-danger position-fixed top-0 end-0 m-3 shadow";
                notification.style.zIndex = "9999";
                notification.innerHTML = `<i class="fas fa-exclamation-triangle me-2"></i> Đơn hàng này vừa bị xóa! Không thể lưu thay đổi.`;
                document.body.appendChild(notification);
            }
        });

        connection.on("ReceiveUpdate_OrdersNamNH", function (updatedOrder) {
            var orderIdFromUpdate = updatedOrder.orderId || updatedOrder.OrderId;
            if (currentOrderId === parseInt(orderIdFromUpdate)) {
                var notification = document.createElement("div");
                notification.className = "alert alert-warning position-fixed top-0 end-0 m-3 shadow alert-dismissible fade show";
                notification.style.zIndex = "9999";
                notification.innerHTML = `
                    <i class="fas fa-exclamation-triangle me-2"></i> Đơn hàng này vừa được cập nhật ở nơi khác!
                    <button class="btn btn-sm btn-outline-dark ms-2" onclick="location.reload()">Tải lại trang</button>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                `;
                document.body.appendChild(notification);
            }
        });
    </script>
}
