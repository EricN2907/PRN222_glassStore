@page
@model glassStore.RazorWebApp.NamNH.Pages.OrdersNamNhs.EditModel

@{
    ViewData["Title"] = "Update Order";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Edit Order</h1>
            <p class="text-muted small">Update order information for <strong class="text-primary">@Model.OrdersNamNh.OrderCode</strong></p>
        </div>
        <a asp-page="./Index" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left"></i> Back to List
        </a>
    </div>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-4" role="alert"></div>
        <input type="hidden" asp-for="OrdersNamNh.OrderId" />

        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h6 class="m-0 font-weight-bold text-primary">General Information</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6 mb-3">
                                <label asp-for="OrdersNamNh.OrderCode" class="form-label text-muted small">Order Code</label>
                                <input asp-for="OrdersNamNh.OrderCode" class="form-control bg-light" readonly />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="OrdersNamNh.Status" class="form-label small font-weight-bold">Order Status</label>
                                <select asp-for="OrdersNamNh.Status" class="form-control form-select">
                                    <option value="Pending">Pending</option>
                                    <option value="Processing">Processing</option>
                                    <option value="Completed">Completed</option>
                                    <option value="Cancelled">Cancelled</option>
                                </select>
                                <span asp-validation-for="OrdersNamNh.Status" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="OrdersNamNh.UserId" class="form-label small">Customer</label>
                                <select asp-for="OrdersNamNh.UserId" class="form-control form-select" asp-items="ViewBag.UserId"></select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="OrdersNamNh.VoucherId" class="form-label small">Voucher Applied</label>
                                <select asp-for="OrdersNamNh.VoucherId" class="form-control form-select" asp-items="ViewBag.VoucherId">
                                    <option value="">-- No Voucher --</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="OrdersNamNh.OrderType" class="form-label small">Order Type</label>
                                <input asp-for="OrdersNamNh.OrderType" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="OrdersNamNh.PaymentMethod" class="form-label small">Payment Method</label>
                                <input asp-for="OrdersNamNh.PaymentMethod" class="form-control" />
                            </div>

                            <div class="col-12 mb-3">
                                <label asp-for="OrdersNamNh.CustomerNote" class="form-label small">Customer Note</label>
                                <textarea asp-for="OrdersNamNh.CustomerNote" class="form-control" rows="2"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h6 class="m-0 font-weight-bold text-info">Shipping Details</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="OrdersNamNh.ReceiverName" class="form-label small">Receiver Name</label>
                                <input asp-for="OrdersNamNh.ReceiverName" class="form-control" />
                                <span asp-validation-for="OrdersNamNh.ReceiverName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="OrdersNamNh.ReceiverPhone" class="form-label small">Phone Number</label>
                                <input asp-for="OrdersNamNh.ReceiverPhone" class="form-control" />
                                <span asp-validation-for="OrdersNamNh.ReceiverPhone" class="text-danger"></span>
                            </div>
                            <div class="col-12 mb-3">
                                <label asp-for="OrdersNamNh.ReceiverAddress" class="form-label small">Address</label>
                                <input asp-for="OrdersNamNh.ReceiverAddress" class="form-control" />
                                <span asp-validation-for="OrdersNamNh.ReceiverAddress" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm mb-4 border-primary">
                    <div class="card-header bg-primary text-white py-3">
                        <h6 class="m-0 font-weight-bold">Order Summary</h6>
                    </div>
                    <div class="card-body bg-light">
                        <div class="mb-3">
                            <label asp-for="OrdersNamNh.Subtotal" class="form-label small text-muted">Subtotal</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="OrdersNamNh.Subtotal" class="form-control text-end" placeholder="0.00" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="OrdersNamNh.DiscountTotal" class="form-label small text-muted">Discount</label>
                            <div class="input-group">
                                <span class="input-group-text text-success">-</span>
                                <input asp-for="OrdersNamNh.DiscountTotal" class="form-control text-end text-success" placeholder="0.00" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="OrdersNamNh.TaxTotal" class="form-label small text-muted">Tax</label>
                            <div class="input-group">
                                <span class="input-group-text">+</span>
                                <input asp-for="OrdersNamNh.TaxTotal" class="form-control text-end" placeholder="0.00" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="OrdersNamNh.ShippingFee" class="form-label small text-muted">Shipping Fee</label>
                            <div class="input-group">
                                <span class="input-group-text">+</span>
                                <input asp-for="OrdersNamNh.ShippingFee" class="form-control text-end" placeholder="0.00" />
                            </div>
                        </div>
                        <hr />
                        <div class="mb-3">
                            <label asp-for="OrdersNamNh.GrandTotal" class="form-label font-weight-bold">Grand Total</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-white border-primary text-primary fw-bold">$</span>
                                <input asp-for="OrdersNamNh.GrandTotal" class="form-control text-end font-weight-bold text-primary border-primary" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="OrdersNamNh.GrandTotal" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="OrdersNamNh.CreatedAt" class="form-label small text-muted">Created At</label>
                            <input asp-for="OrdersNamNh.CreatedAt" class="form-control form-control-sm bg-light" readonly />
                        </div>
                        <div class="mb-3">
                            <label asp-for="OrdersNamNh.UpdatedAt" class="form-label small text-muted">Last Updated</label>
                            <input asp-for="OrdersNamNh.UpdatedAt" class="form-control form-control-sm bg-light" readonly />
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                        <i class="fa fa-save"></i> Save Changes
                    </button>
                    <button type="button" id="btnHubUpdate" class="btn btn-warning btn-lg shadow-sm">
                        <i class="fas fa-wifi"></i> Update By SignalR
                    </button>
                    <a asp-page="./Index" class="btn btn-light text-secondary">Cancel</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        "use strict";

        var connection = new signalR.HubConnectionBuilder().withUrl("/glassStore_Hub").build();

        connection.on("UpdateSuccess", function () {
            alert("Hệ thống: Đã cập nhật đơn hàng thành công qua SignalR!");
            window.location.href = "/OrdersNamNhs/Index";
        });

        connection.on("ReceiveErrorNamNH", function (msg) {
            alert("Lỗi: " + msg);
        });

        connection.start().then(function () {
            console.log("NamNH Edit: Connected to the SignalR Hub");
        }).catch(function (err) {
            return console.error(err.toString());
        });

        var currentOrderId = parseInt("@Model.OrdersNamNh.OrderId");

        connection.on("ReceiveDelete_OrdersNamNH", function (orderId) {
            if (currentOrderId === parseInt(orderId)) {
                var btnSb = document.querySelector('button[type="submit"]');
                if(btnSb) btnSb.disabled = true;
                
                var notification = document.createElement("div");
                notification.className = "alert alert-danger position-fixed top-0 end-0 m-3 shadow";
                notification.style.zIndex = "9999";
                notification.innerHTML = `<i class="fas fa-exclamation-triangle me-2"></i> Đơn hàng này vừa bị xóa! Không thể lưu thay đổi.`;
                document.body.appendChild(notification);
            }
        });

        connection.on("ReceiveUpdate_OrdersNamNH", function (updatedOrder) {
            var orderIdFromUpdate = updatedOrder.orderId || updatedOrder.OrderId;
            if (currentOrderId === parseInt(orderIdFromUpdate)) {
                var notification = document.createElement("div");
                notification.className = "alert alert-warning position-fixed top-0 end-0 m-3 shadow alert-dismissible fade show";
                notification.style.zIndex = "9999";
                notification.innerHTML = `
                    <i class="fas fa-exclamation-triangle me-2"></i> Đơn hàng này vừa được cập nhật ở nơi khác!
                    <button class="btn btn-sm btn-outline-dark ms-2" onclick="location.reload()">Tải lại trang</button>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                `;
                document.body.appendChild(notification);
            }
        });

        var btnHubUpdate = document.getElementById("btnHubUpdate");
        if (btnHubUpdate) {
            btnHubUpdate.addEventListener("click", function (event) {
                event.preventDefault();
                
                var formObj = {
                    OrderId: currentOrderId,
                    OrderCode: document.getElementById("OrdersNamNh_OrderCode").value,
                    Status: document.getElementById("OrdersNamNh_Status").value,
                    UserId: parseInt(document.getElementById("OrdersNamNh_UserId").value) || null,
                    VoucherId: parseInt(document.getElementById("OrdersNamNh_VoucherId").value) || null,
                    OrderType: document.getElementById("OrdersNamNh_OrderType").value,
                    PaymentMethod: document.getElementById("OrdersNamNh_PaymentMethod").value,
                    CustomerNote: document.getElementById("OrdersNamNh_CustomerNote").value,
                    ReceiverName: document.getElementById("OrdersNamNh_ReceiverName").value,
                    ReceiverPhone: document.getElementById("OrdersNamNh_ReceiverPhone").value,
                    ReceiverAddress: document.getElementById("OrdersNamNh_ReceiverAddress").value,
                    Subtotal: parseFloat(document.getElementById("OrdersNamNh_Subtotal").value) || 0,
                    DiscountTotal: parseFloat(document.getElementById("OrdersNamNh_DiscountTotal").value) || 0,
                    TaxTotal: parseFloat(document.getElementById("OrdersNamNh_TaxTotal").value) || 0,
                    ShippingFee: parseFloat(document.getElementById("OrdersNamNh_ShippingFee").value) || 0,
                    GrandTotal: parseFloat(document.getElementById("OrdersNamNh_GrandTotal").value) || 0,
                    CreatedAt: document.getElementById("OrdersNamNh_CreatedAt").value || null,
                    UpdatedAt: document.getElementById("OrdersNamNh_UpdatedAt").value || null
                };

                connection.invoke("hubUpdate_OrdersNamNH", formObj)
                    .catch(function (err) {
                        console.error(err.toString());
                    });
            });
        }
    </script>
}
