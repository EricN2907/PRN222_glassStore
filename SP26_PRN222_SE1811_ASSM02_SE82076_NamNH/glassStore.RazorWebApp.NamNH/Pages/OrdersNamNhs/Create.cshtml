@page
@model glassStore.RazorWebApp.NamNH.Pages.OrdersNamNhs.CreateModel
@{
    ViewData["Title"] = "Create Order";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">🛒 Create New Order</h4>
                </div>

                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <!-- LEFT COLUMN -->
                            <div class="col-md-6">
                                <h6 class="text-muted mb-3">Order Information</h6>

                                <div class="mb-3">
                                    <label asp-for="OrdersNamNh.UserId" class="form-label"></label>
                                    <select asp-for="OrdersNamNh.UserId"
                                            class="form-select"
                                            asp-items="ViewBag.UserId">
                                        <option value="">-- Select User --</option>
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="OrdersNamNh.VoucherId" class="form-label"></label>
                                    <select asp-for="OrdersNamNh.VoucherId"
                                            class="form-select"
                                            asp-items="ViewBag.VoucherId">
                                        <option value="">-- No Voucher --</option>
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="OrdersNamNh.OrderType" class="form-label"></label>
                                    <input asp-for="OrdersNamNh.OrderType" class="form-control" />
                                </div>

                                <div class="mb-3">
                                    <label asp-for="OrdersNamNh.OrderCode" class="form-label"></label>
                                    <input asp-for="OrdersNamNh.OrderCode" class="form-control" />
                                </div>

                                <div class="mb-3">
                                    <label asp-for="OrdersNamNh.PaymentMethod" class="form-label"></label>
                                    <select asp-for="OrdersNamNh.PaymentMethod" class="form-select">
                                        <option>COD</option>
                                        <option>Banking</option>
                                        <option>VNPay</option>
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="OrdersNamNh.Status" class="form-label"></label>
                                    <select asp-for="OrdersNamNh.Status" class="form-select">
                                        <option>Pending</option>
                                        <option>Paid</option>
                                        <option>Cancelled</option>
                                    </select>
                                </div>
                            </div>

                            <!-- RIGHT COLUMN -->
                            <div class="col-md-6">
                                <h6 class="text-muted mb-3">Receiver & Payment</h6>

                                <div class="mb-3">
                                    <label asp-for="OrdersNamNh.ReceiverName" class="form-label"></label>
                                    <input asp-for="OrdersNamNh.ReceiverName" class="form-control" />
                                </div>

                                <div class="mb-3">
                                    <label asp-for="OrdersNamNh.ReceiverPhone" class="form-label"></label>
                                    <input asp-for="OrdersNamNh.ReceiverPhone" class="form-control" />
                                </div>

                                <div class="mb-3">
                                    <label asp-for="OrdersNamNh.ReceiverAddress" class="form-label"></label>
                                    <textarea asp-for="OrdersNamNh.ReceiverAddress"
                                              class="form-control"
                                              rows="2"></textarea>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="OrdersNamNh.Subtotal" class="form-label"></label>
                                        <div class="input-group">
                                            <span class="input-group-text">₫</span>
                                            <input asp-for="OrdersNamNh.Subtotal" class="form-control" />
                                        </div>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label asp-for="OrdersNamNh.DiscountTotal" class="form-label"></label>
                                        <div class="input-group">
                                            <span class="input-group-text">₫</span>
                                            <input asp-for="OrdersNamNh.DiscountTotal" class="form-control" />
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="OrdersNamNh.TaxTotal" class="form-label"></label>
                                        <input asp-for="OrdersNamNh.TaxTotal" class="form-control" />
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label asp-for="OrdersNamNh.ShippingFee" class="form-label"></label>
                                        <input asp-for="OrdersNamNh.ShippingFee" class="form-control" />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="OrdersNamNh.GrandTotal" class="form-label fw-bold"></label>
                                    <input asp-for="OrdersNamNh.GrandTotal"
                                           class="form-control fw-bold text-success" />
                                </div>

                                <div class="mb-3">
                                    <label asp-for="OrdersNamNh.CustomerNote" class="form-label"></label>
                                    <textarea asp-for="OrdersNamNh.CustomerNote"
                                              class="form-control"
                                              rows="2"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="text-end mt-4">
                            <a asp-page="Index" class="btn btn-outline-secondary me-2">
                                ← Back
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                ✅ Save (HTTP)
                            </button>
                            <button type="button" id="btnHubCreate" class="btn btn-success px-4 ms-2">
                                🚀 Create By SignalR
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        "use strict";

        var connection = new signalR.HubConnectionBuilder().withUrl("/glassStore_Hub").build();

        connection.on("CreateSuccess", function () {
            alert("Hệ thống: Đã tạo đơn hàng thành công qua SignalR!");
            window.location.href = "/OrdersNamNhs/Index";
        });

        connection.on("ReceiveErrorNamNH", function (msg) {
            alert("Lỗi: " + msg);
        });

        connection.start().then(function () {
            console.log("NamNH Create: Connected to the SignalR Hub");
        }).catch(function (err) {
            return console.error(err.toString());
        });

        var btnHubCreate = document.getElementById("btnHubCreate");
        if (btnHubCreate) {
            btnHubCreate.addEventListener("click", function (event) {
                event.preventDefault();
                
                var formObj = {
                    OrderCode: document.getElementById("OrdersNamNh_OrderCode").value,
                    Status: document.getElementById("OrdersNamNh_Status").value,
                    UserId: parseInt(document.getElementById("OrdersNamNh_UserId").value) || null,
                    VoucherId: parseInt(document.getElementById("OrdersNamNh_VoucherId").value) || null,
                    OrderType: document.getElementById("OrdersNamNh_OrderType").value,
                    PaymentMethod: document.getElementById("OrdersNamNh_PaymentMethod").value,
                    CustomerNote: document.getElementById("OrdersNamNh_CustomerNote").value,
                    ReceiverName: document.getElementById("OrdersNamNh_ReceiverName").value,
                    ReceiverPhone: document.getElementById("OrdersNamNh_ReceiverPhone").value,
                    ReceiverAddress: document.getElementById("OrdersNamNh_ReceiverAddress").value,
                    Subtotal: parseFloat(document.getElementById("OrdersNamNh_Subtotal").value) || 0,
                    DiscountTotal: parseFloat(document.getElementById("OrdersNamNh_DiscountTotal").value) || 0,
                    TaxTotal: parseFloat(document.getElementById("OrdersNamNh_TaxTotal").value) || 0,
                    ShippingFee: parseFloat(document.getElementById("OrdersNamNh_ShippingFee").value) || 0,
                    GrandTotal: parseFloat(document.getElementById("OrdersNamNh_GrandTotal").value) || 0
                };

                connection.invoke("hubCreate_OrdersNamNH", formObj)
                    .catch(function (err) {
                        console.error(err.toString());
                    });
            });
        }
    </script>
}
