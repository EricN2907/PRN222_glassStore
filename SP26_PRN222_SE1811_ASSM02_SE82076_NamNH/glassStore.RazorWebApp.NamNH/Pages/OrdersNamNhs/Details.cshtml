@page
@model glassStore.RazorWebApp.NamNH.Pages.OrdersNamNhs.DetailsModel

@{
    ViewData["Title"] = "Order Details";
}

<div class="container mt-4" id="Order_id">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow border-0">

                <!-- HEADER -->
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-0">🧾 Order Details</h4>
                        <small>Order Code: <strong>@Model.OrdersNamNh.OrderCode</strong></small>
                        @Html.HiddenFor(model => model.OrdersNamNh.OrderId)
                    </div>

                    <span class="badge
                        @(Model.OrdersNamNh.Status == "Paid" ? "bg-success" :
                                                    Model.OrdersNamNh.Status == "Pending" ? "bg-warning text-dark" :
                                                    "bg-danger")">
                        @Model.OrdersNamNh.Status
                    </span>
                </div>

                <div class="card-body">

                    <!-- ORDER INFO -->
                    <h6 class="text-muted mb-3">Order Information</h6>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <p><strong>Order Type:</strong> @Model.OrdersNamNh.OrderType</p>
                            <p><strong>Payment Method:</strong> @Model.OrdersNamNh.PaymentMethod</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>User Email:</strong> @Model.OrdersNamNh.User?.Email</p>
                            <p>
                                <strong>Voucher:</strong>
                                @(Model.OrdersNamNh.Voucher != null
                                                                ? Model.OrdersNamNh.Voucher.Code
                                                                : "No voucher")
                            </p>
                        </div>
                    </div>

                    <hr />

                    <!-- RECEIVER -->
                    <h6 class="text-muted mb-3">Receiver Information</h6>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <p><strong>Name:</strong> @Model.OrdersNamNh.ReceiverName</p>
                            <p><strong>Phone:</strong> @Model.OrdersNamNh.ReceiverPhone</p>
                        </div>
                        <div class="col-md-6">
                            <p>
                                <strong>Address:</strong><br />
                                @Model.OrdersNamNh.ReceiverAddress
                            </p>
                        </div>
                    </div>

                    <hr />

                    <!-- PAYMENT -->
                    <h6 class="text-muted mb-3">Payment Summary</h6>
                    <div class="row">
                        <div class="col-md-6">
                            <p>Subtotal:</p>
                            <p>Discount:</p>
                            <p>Tax:</p>
                            <p>Shipping Fee:</p>
                        </div>
                        <div class="col-md-6 text-end">
                            <p>₫ @Model.OrdersNamNh.Subtotal</p>
                            <p class="text-danger">- ₫ @Model.OrdersNamNh.DiscountTotal</p>
                            <p>₫ @Model.OrdersNamNh.TaxTotal</p>
                            <p>₫ @Model.OrdersNamNh.ShippingFee</p>
                        </div>
                    </div>

                    <div class="row border-top pt-3 mt-3">
                        <div class="col-md-6">
                            <strong>Grand Total</strong>
                        </div>
                        <div class="col-md-6 text-end">
                            <strong class="text-success fs-5">
                                ₫ @Model.OrdersNamNh.GrandTotal
                            </strong>
                        </div>
                    </div>

                    <hr />

                    <!-- NOTE -->
                    @if (!string.IsNullOrEmpty(Model.OrdersNamNh.CustomerNote))
                    {
                        <h6 class="text-muted">Customer Note</h6>
                        <div class="alert alert-secondary">
                            @Model.OrdersNamNh.CustomerNote
                        </div>
                    }

                    <!-- META -->
                    <div class="row text-muted small">
                        <div class="col-md-6">
                            Created At: @Model.OrdersNamNh.CreatedAt
                        </div>
                        <div class="col-md-6 text-end">
                            Updated At: @Model.OrdersNamNh.UpdatedAt
                        </div>
                    </div>
                </div>

                <!-- FOOTER -->
                <div class="card-footer text-end bg-light">
                    <a asp-page="./Index" class="btn btn-outline-secondary me-2">
                        ← Back to List
                    </a>
                    <a asp-page="./Edit"
                       asp-route-id="@Model.OrdersNamNh.OrderId"
                       class="btn btn-primary">
                        ✏️ Edit Order
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>
<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
<script>
    "use strict";

    var connection = new signalR.HubConnectionBuilder().withUrl("/glassStore_Hub").build();

    connection.start().then(function () {
        console.log("NamNH Details: Connected to the SignalR Hub");
    }).catch(function (err) {
        return console.error(err.toString());
    });

    // Lấy ID đơn hàng hiện tại đang xem thông qua Razor
    var currentOrderId = parseInt("@Model.OrdersNamNh.OrderId");

    connection.on("ReceiveDelete_OrdersNamNH", function (orderId) {
        // Kiểm tra nếu ID đơn hàng bị xóa chính là đơn hàng đang mở
        if (currentOrderId === parseInt(orderId)) {
            // Xóa sạch nội dung chi tiết và hiển thị cảnh báo
            document.getElementById("Order_id").innerHTML = `
                <div class="alert alert-danger text-center shadow-sm p-5 mt-5">
                    <h4 class="text-danger"><i class="fas fa-exclamation-triangle"></i> Yikes! Đơn hàng đã bị xóa</h4>
                    <p class="text-muted mt-3">Đơn hàng này vừa bị xóa khỏi hệ thống. Bạn không thể tiếp tục xem chi tiết.</p>
                    <a href="./Index" class="btn btn-outline-danger mt-3">← Quay lại danh sách</a>
                </div>
            `;
        }
        // Bỏ else block vì nếu orderId khác, ta cứ bơ đi, không cần làm phiền người dùng.
    });

    connection.on("ReceiveUpdate_OrdersNamNH", function (updatedOrder) {
        var orderIdFromUpdate = updatedOrder.orderId || updatedOrder.OrderId;
        if (currentOrderId === parseInt(orderIdFromUpdate)) {
            var notification = document.createElement("div");
            notification.className = "alert alert-info position-fixed top-0 end-0 m-3 shadow";
            notification.style.zIndex = "9999";
            notification.innerHTML = `<i class="fas fa-info-circle me-2"></i> Đơn hàng vừa được cập nhật! Đang tải lại dữ liệu...`;
            document.body.appendChild(notification);
            
            setTimeout(function() {
                location.reload();
            }, 1000);
        }
    });

</script>