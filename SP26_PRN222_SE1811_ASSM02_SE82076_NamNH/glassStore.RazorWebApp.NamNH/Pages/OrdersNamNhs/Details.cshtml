@page
@model glassStore.RazorWebApp.NamNH.Pages.OrdersNamNhs.DetailsModel

@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<style>
    /* Glass Store Theme - Details Page */
    body {
        background-color: #f4f6f9;
        font-family: 'Segoe UI', sans-serif;
    }

    .page-header {
        border-left: 5px solid #17a2b8;
        padding-left: 15px;
        color: #2c3e50;
        font-weight: 700;
    }

    .card-custom {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        background: white;
    }

    .section-title {
        font-size: 1.1rem;
        color: #17a2b8;
        border-bottom: 2px solid #f1f1f1;
        padding-bottom: 10px;
        margin-bottom: 20px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .detail-label {
        color: #6c757d;
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 5px;
    }

    .detail-value {
        color: #2c3e50;
        font-weight: 500;
        font-size: 1rem;
        margin-bottom: 15px;
        word-wrap: break-word;
    }

    .badge-status {
        padding: 8px 15px;
        border-radius: 20px;
        font-size: 0.85rem;
    }

    .total-section {
        background-color: #f8f9fa;
        border-radius: 10px;
        padding: 20px;
    }

    .grand-total {
        font-size: 1.5rem;
        color: #198754; /* Green */
        font-weight: 800;
    }
    
    #val-CustomerNote {
        white-space: pre-wrap;
    }
</style>

<div class="container py-4" id="Order_id">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-header text-uppercase">
            <i class="fas fa-file-invoice me-2 text-info"></i> Chi Tiết Đơn Hàng
        </h2>
        <div>
            <a asp-page="./Edit" asp-route-id="@Model.OrdersNamNh.OrderId" class="btn btn-warning text-white shadow-sm me-2">
                <i class="fas fa-pen me-1"></i> Chỉnh sửa
            </a>
            <a asp-page="./Index" class="btn btn-outline-secondary shadow-sm">
                <i class="fas fa-arrow-left me-1"></i> Quay lại
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card card-custom p-4 mb-4">

                <div class="row mb-4 align-items-center">
                    <div class="col-md-6">
                        <h4 id="val-OrderCode" class="text-primary fw-bold mb-1">@Html.DisplayFor(model => model.OrdersNamNh.OrderCode)</h4>
                        <span class="text-muted small">
                            <i class="far fa-clock me-1"></i> Ngày tạo: <span id="val-CreatedAt">@Html.DisplayFor(model => model.OrdersNamNh.CreatedAt)</span>
                        </span>
                    </div>
                    <div class="col-md-6 text-md-end mt-3 mt-md-0">
                        @{
                            var statusClass = "bg-secondary";
                            if (Model.OrdersNamNh.Status != null)
                            {
                                var st = Model.OrdersNamNh.Status.ToString().ToLower();
                                if (st.Contains("success") || st.Contains("done") || st.Contains("completed")) { statusClass = "bg-success"; }
                                else if (st.Contains("pending") || st.Contains("process")) { statusClass = "bg-warning text-dark"; }
                                else if (st.Contains("cancel") || st.Contains("fail")) { statusClass = "bg-danger"; }
                                else { statusClass = "bg-info"; }
                            }
                        }
                        <span id="val-Status" class="badge @statusClass badge-status shadow-sm">
                            @Html.DisplayFor(model => model.OrdersNamNh.Status)
                        </span>
                    </div>
                </div>

                <hr class="text-muted opacity-25 mb-4">

                <div class="row">
                    <div class="col-md-4">
                        <div class="section-title"><i class="fas fa-info-circle me-2"></i>Thông Tin Chung</div>

                        <div class="detail-label">Loại đơn hàng</div>
                        <div id="val-OrderType" class="detail-value">@Html.DisplayFor(model => model.OrdersNamNh.OrderType)</div>

                        <div class="detail-label">Phương thức thanh toán</div>
                        <div id="val-PaymentMethod" class="detail-value">@(Model.OrdersNamNh.PaymentMethod == "Banking" || (Model.OrdersNamNh.PaymentMethod != null && Model.OrdersNamNh.PaymentMethod.Contains("?")) ? "Chuyển khoản" : Model.OrdersNamNh.PaymentMethod)</div>

                        <div class="detail-label">Tài khoản đặt (User)</div>
                        <div class="detail-value">
                            @if (Model.OrdersNamNh.User != null)
                            {
                                @Html.DisplayFor(model => model.OrdersNamNh.User.Email)
                            }
                            else
                            {
                                <span class="text-muted font-italic">Khách vãng lai</span>
                            }
                        </div>

                        <div class="detail-label">Voucher</div>
                        <div class="detail-value">
                            @if (Model.OrdersNamNh.Voucher != null)
                            {
                                <span class="badge bg-primary">@Html.DisplayFor(model => model.OrdersNamNh.Voucher.Code)</span>
                            }
                            else
                            {
                                <span class="text-muted">- Không có -</span>
                            }
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="section-title"><i class="fas fa-user-tag me-2"></i>Người Nhận</div>

                        <div class="detail-label">Họ và tên</div>
                        <div id="val-ReceiverName" class="detail-value fw-bold">@Html.DisplayFor(model => model.OrdersNamNh.ReceiverName)</div>

                        <div class="detail-label">Số điện thoại</div>
                        <div id="val-ReceiverPhone" class="detail-value">@Html.DisplayFor(model => model.OrdersNamNh.ReceiverPhone)</div>

                        <div class="detail-label">Địa chỉ giao hàng</div>
                        <div id="val-ReceiverAddress" class="detail-value">@Html.DisplayFor(model => model.OrdersNamNh.ReceiverAddress)</div>
                    </div>

                    <div class="col-md-4">
                        <div class="section-title"><i class="fas fa-sticky-note me-2"></i>Ghi Chú</div>
                        <div id="val-CustomerNote" class="p-3 bg-light rounded text-muted fst-italic border">@if (!string.IsNullOrEmpty(Model.OrdersNamNh.CustomerNote)) { @Html.DisplayFor(model => model.OrdersNamNh.CustomerNote) } else { <span>Không có ghi chú nào từ khách hàng.</span> }</div>
                        <div class="mt-3">
                            <div class="detail-label">Cập nhật lần cuối</div>
                            <div id="val-UpdatedAt" class="text-muted small">@Html.DisplayFor(model => model.OrdersNamNh.UpdatedAt)</div>
                        </div>
                    </div>
                </div>

                <div class="mt-5 total-section">
                    <div class="section-title border-0 pb-0 mb-3"><i class="fas fa-receipt me-2"></i>Chi Tiết Thanh Toán</div>
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <div class="detail-label">Tạm tính (Subtotal)</div>
                            <div id="val-Subtotal" class="fw-bold">@Model.OrdersNamNh.Subtotal?.ToString("N0") ₫</div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="detail-label">Giảm giá (Discount)</div>
                            <div id="val-DiscountTotal" class="fw-bold text-danger">- @Model.OrdersNamNh.DiscountTotal?.ToString("N0") ₫</div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="detail-label">Thuế (Tax)</div>
                            <div id="val-TaxTotal" class="fw-bold">@Model.OrdersNamNh.TaxTotal?.ToString("N0") ₫</div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="detail-label">Phí ship</div>
                            <div id="val-ShippingFee" class="fw-bold">@Model.OrdersNamNh.ShippingFee?.ToString("N0") ₫</div>
                        </div>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="h5 text-uppercase text-secondary mb-0">Tổng cộng (Grand Total):</span>
                        <span id="val-GrandTotal" class="grand-total text-end">@((Model.OrdersNamNh.GrandTotal ?? 0).ToString("N0")) ₫</span>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
<script>
    "use strict";

    var connection = new signalR.HubConnectionBuilder().withUrl("/glassStore_Hub").build();

    connection.start().then(function () {
        console.log("NamNH Details: Connected to the SignalR Hub");
    }).catch(function (err) {
        return console.error(err.toString());
    });

    var currentOrderId = parseInt("@Model.OrdersNamNh.OrderId");

    connection.on("ReceiveDelete_OrdersNamNH", function (orderId) {
        if (currentOrderId === parseInt(orderId)) {
            document.getElementById("Order_id").innerHTML = `
                <div class="alert alert-danger text-center shadow-sm p-5 mt-5">
                    <h4 class="text-danger"><i class="fas fa-exclamation-triangle"></i> Yikes! Đơn hàng đã bị xóa</h4>
                    <p class="text-muted mt-3">Đơn hàng này vừa bị xóa khỏi hệ thống. Bạn không thể tiếp tục xem chi tiết.</p>
                    <a href="./Index" class="btn btn-outline-danger mt-3">← Quay lại danh sách</a>
                </div>
            `;
        }
    });

    function formatCurrency(value) {
        if (value === null || value === undefined) return "0";
        return Number(value).toLocaleString("vi-VN");
    }
    function formatDate(dateStr) {
        if (!dateStr) return "";
        var date = new Date(dateStr);
        var d = date.getDate().toString().padStart(2, '0');
        var m = (date.getMonth() + 1).toString().padStart(2, '0');
        var y = date.getFullYear();
        var h = date.getHours().toString().padStart(2, '0');
        var min = date.getMinutes().toString().padStart(2, '0');
        return `${d}/${m}/${y} ${h}:${min}`;
    }
    function formatPaymentMethod(method) {
        if (!method) return "";
        if (method === "Banking" || method.includes("?")) return "Chuyển khoản";
        return method;
    }
    function getStatusBadgeClass(status) {
        if (!status) return "bg-secondary";
        var st = status.toLowerCase();
        if (st.includes("success") || st.includes("done") || st.includes("completed")) return "bg-success";
        if (st.includes("pending") || st.includes("process")) return "bg-warning text-dark";
        if (st.includes("cancel") || st.includes("fail")) return "bg-danger";
        return "bg-info";
    }

    connection.on("ReceiveUpdate_OrdersNamNH", function (updatedOrder) {
        var orderIdFromUpdate = updatedOrder.orderId || updatedOrder.OrderId;
        if (currentOrderId === parseInt(orderIdFromUpdate)) {
            
            document.getElementById("val-OrderCode").innerText = updatedOrder.orderCode || '';
            document.getElementById("val-CreatedAt").innerText = formatDate(updatedOrder.createdAt);
            
            var statusEl = document.getElementById("val-Status");
            statusEl.innerText = updatedOrder.status || '';
            statusEl.className = "badge badge-status shadow-sm " + getStatusBadgeClass(updatedOrder.status);

            document.getElementById("val-OrderType").innerText = updatedOrder.orderType || '';
            document.getElementById("val-PaymentMethod").innerText = formatPaymentMethod(updatedOrder.paymentMethod);
            
            document.getElementById("val-ReceiverName").innerText = updatedOrder.receiverName || '';
            document.getElementById("val-ReceiverPhone").innerText = updatedOrder.receiverPhone || '';
            document.getElementById("val-ReceiverAddress").innerText = updatedOrder.receiverAddress || '';
            
            document.getElementById("val-CustomerNote").innerText = updatedOrder.customerNote || 'Không có ghi chú nào từ khách hàng.';
            document.getElementById("val-UpdatedAt").innerText = formatDate(updatedOrder.updatedAt);
            
            document.getElementById("val-Subtotal").innerText = formatCurrency(updatedOrder.subtotal) + " ₫";
            document.getElementById("val-DiscountTotal").innerText = "- " + formatCurrency(updatedOrder.discountTotal) + " ₫";
            document.getElementById("val-TaxTotal").innerText = formatCurrency(updatedOrder.taxTotal) + " ₫";
            document.getElementById("val-ShippingFee").innerText = formatCurrency(updatedOrder.shippingFee) + " ₫";
            document.getElementById("val-GrandTotal").innerText = formatCurrency(updatedOrder.grandTotal) + " ₫";
            
            const docOrder = document.getElementById("Order_id");
            docOrder.style.transition = "background-color 0.5s";
            docOrder.style.backgroundColor = "#fff3cd";
            setTimeout(() => { docOrder.style.backgroundColor = "transparent"; }, 1500);

            var notification = document.createElement("div");
            notification.className = "alert alert-info position-fixed top-0 end-0 m-3 shadow alert-dismissible fade show";
            notification.style.zIndex = "9999";
            notification.innerHTML = `
                <i class="fas fa-info-circle me-2"></i> Đơn hàng vừa được cập nhật tự động!
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            `;
            document.body.appendChild(notification);
            
            setTimeout(() => { 
                if (notification && notification.parentNode) notification.parentNode.removeChild(notification); 
            }, 3500);
        }
    });
</script>